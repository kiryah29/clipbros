# Only needed for real (non-demo) runs. Demo mode needs nothing.
YOUTUBE_API_KEY=
# Twitch chat can be read anonymously; set these to read as your bot account instead.
TWITCH_BOT_NICK=
TWITCH_OAUTH_TOKEN=
# Kick: fill in once you have access to Kick's official developer API.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# TikTok Content Posting API (developers.tiktok.com > your app). The redirect URI must be
# registered in the app and be HTTPS, e.g. a tunnel URL like https://xxxx.trycloudflare.com/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
# TIKTOK_SCOPES=user.info.basic,video.publish
# Caption prefilled on the TikTok review screen; {channel} is replaced by the streamer's name.
# TIKTOK_DEFAULT_CAPTION=Clip from {channel} #fyp #streamer #clips
# Instagram, through Facebook Login (developers.facebook.com > your app).
# Use the Meta App ID and App secret from App settings > Basic. Add every redirect URI, exactly,
# under Facebook Login > Settings > Valid OAuth Redirect URIs. Keep the secret here only.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Comma-separated. The app uses the one whose host the page was opened on, else the first.
INSTAGRAM_REDIRECT_URIS=https://laptop.clipbros.app/callback/instagram,https://clipbros.app/callback/instagram
# Caption prefilled under the hook on the Instagram review screen; {channel} is replaced.
# INSTAGRAM_DEFAULT_CAPTION=Clip from {channel} #gaming #streamer #clips #reels
